# The go_library rule is imported as a different name in this case,
# in order to avoid automated tooling doing the wrong thing with the
# operating-specific dependencies listed below.
load("//tools:defs.bzl", "go_test", "select_system", exempt_go_library = "go_library")

package(
    default_applicable_licenses = ["//:license"],
    licenses = ["notice"],
)

exempt_go_library(
    name = "sandbox",
    srcs = [
        "cpulimits.go",
        "network.go",
        "network_darwin.go",
        "network_unsafe.go",
        "no_xdp.go",
        "proxy_link.go",
        "sandbox.go",
        "sandbox_darwin.go",
        "sandbox_linux.go",
        "xdp.go",
    ],
    # Nothing needs to be stateified, and stateify has trouble when select is
    # used to choose deps.
    stateify = False,
    visibility = [
        "//runsc:__subpackages__",
        "//test:__subpackages__",
    ],
    deps = [
        "//pkg/abi/linux",
        "//pkg/atomicbitops",
        "//pkg/cleanup",
        "//pkg/control/api",
        "//pkg/control/client",
        "//pkg/control/server",
        "//pkg/coverage",
        "//pkg/fd",
        "//pkg/hostos",
        "//pkg/log",
        "//pkg/metric:metric_go_proto",
        "//pkg/pinring",
        "//pkg/prometheus",
        "//pkg/sentry/control/controlapi",
        "//pkg/sentry/devices/nvproxy/nvconf",
        "//pkg/sentry/fscheckpoint",
        "//pkg/sentry/platform/platformdesc",
        "//pkg/sentry/seccheck",
        "//pkg/sentry/state/checkpointfiles",
        "//pkg/state/statefile",
        "//pkg/sync",
        "//pkg/tcpip",
        "//pkg/urpc",
        "//pkg/xdp",
        "//runsc/boot/procfs",
        "//runsc/boot/sentryapi",
        "//runsc/cgroup",
        "//runsc/config",
        "//runsc/console",
        "//runsc/donation",
        "//runsc/gvisorbinaries",
        "//runsc/hostsettings",
        "//runsc/profile",
        "//runsc/specutils",
        "//runsc/starttime",
        "@com_github_moby_sys_capability//:go_default_library",
        "@com_github_opencontainers_runtime_spec//specs-go:go_default_library",
        "@com_github_vishvananda_netlink//:go_default_library",
        "@org_golang_x_sys//unix:go_default_library",
    ] + select_system(
        darwin = [],
        linux = [
            "//runsc/sandbox/bpf",
            "@com_github_cilium_ebpf//:go_default_library",
            "@com_github_cilium_ebpf//link:go_default_library",
        ],
    ),
)

go_test(
    name = "sandbox_test",
    size = "small",
    srcs = [
        "metrics_test.go",
        "network_test.go",
        "sandbox_test.go",
    ],
    embed = [":sandbox"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//pkg/control/server",
        "//pkg/prometheus",
        "//pkg/sentry/control/controlapi",
        "//runsc/boot/sentryapi",
        "//runsc/cgroup",
        "//runsc/config",
        "//runsc/specutils",
        "@com_github_opencontainers_runtime_spec//specs-go:go_default_library",
        "@com_github_vishvananda_netlink//:go_default_library",
        "@org_golang_x_sys//unix:go_default_library",
    ],
)
